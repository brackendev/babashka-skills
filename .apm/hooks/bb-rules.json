{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${PLUGIN_ROOT}/.apm/hooks/scripts/bb-rules.sh",
          "timeout": 15
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "${PLUGIN_ROOT}/.apm/hooks/scripts/bb-rules.sh",
          "timeout": 15
        }
      ]
    }
  ]
}
